// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}

model User {
  id        String  @id @default(auto()) @map("_id") @db.ObjectId
  firstname String
  surname   String
  login     String  @unique
  password  String
  admin     Boolean @default(false)
  tasks     Task[]  // Relación 1-N: Un usuario tiene muchas tareas
}

model Task {
  id          String  @id @default(auto()) @map("_id") @db.ObjectId
  description String
  completed   Boolean @default(false)
  userId      String  @db.ObjectId // ID del usuario propietario
  user        User    @relation(fields: [userId], references: [id])
}